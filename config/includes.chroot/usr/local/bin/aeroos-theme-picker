#!/bin/bash
set -Eeuo pipefail

APP_TITLE="AeroOS Appearance"
if [[ -z "${DISPLAY:-}" ]] || ! command -v zenity >/dev/null 2>&1; then
  printf '%s\n' "Open the theme picker from AeroOS Control Center."
  exit 1
fi

choice="$(zenity --list --radiolist --title="$APP_TITLE" --text="Choose a desktop style. Your selection is saved in your user profile." --column="Use" --column="Appearance preset" --print-column=2 --width=540 --height=430 TRUE "Aero Dark - Blue" FALSE "Aero Dark - Violet" FALSE "Aero Dark - Teal" FALSE "Aero Light - Blue" FALSE "Aero Light - Violet" FALSE "Aero Light - Teal")" || exit 0

case "$choice" in
  "Aero Dark - Blue")
    bg="#0b1220"; surface="#151f30"; surface_hi="#202d43"; border="#34445e"
    text="#eaf0fb"; accent="#8b9cff"; accent_hi="#a8b5ff"
    gtk_theme="Adwaita-dark"; icon_theme="Papirus-Dark"; panel="rgba(11,18,32,0.96)"
    ;;
  "Aero Dark - Violet")
    bg="#100d20"; surface="#211936"; surface_hi="#30254a"; border="#4c3c68"
    text="#f0eaff"; accent="#aa87ff"; accent_hi="#c6adff"
    gtk_theme="Adwaita-dark"; icon_theme="Papirus-Dark"; panel="rgba(16,13,32,0.96)"
    ;;
  "Aero Dark - Teal")
    bg="#091b20"; surface="#122b31"; surface_hi="#1d3c43"; border="#31545b"
    text="#e7f7f6"; accent="#39c6be"; accent_hi="#80e2d9"
    gtk_theme="Adwaita-dark"; icon_theme="Papirus-Dark"; panel="rgba(9,27,32,0.96)"
    ;;
  "Aero Light - Blue")
    bg="#edf2fb"; surface="#ffffff"; surface_hi="#e1e9f6"; border="#c4d1e6"
    text="#17253b"; accent="#536ee8"; accent_hi="#344ac0"
    gtk_theme="Adwaita"; icon_theme="Papirus-Light"; panel="rgba(237,242,251,0.97)"
    ;;
  "Aero Light - Violet")
    bg="#f3effb"; surface="#ffffff"; surface_hi="#eae2f7"; border="#d2c4e9"
    text="#281d3b"; accent="#7954c7"; accent_hi="#5e3eaa"
    gtk_theme="Adwaita"; icon_theme="Papirus-Light"; panel="rgba(243,239,251,0.97)"
    ;;
  "Aero Light - Teal")
    bg="#eaf5f4"; surface="#ffffff"; surface_hi="#dcefed"; border="#bddbd7"
    text="#173331"; accent="#087f79"; accent_hi="#06645f"
    gtk_theme="Adwaita"; icon_theme="Papirus-Light"; panel="rgba(234,245,244,0.97)"
    ;;
  *) exit 0 ;;
esac

config_dir="$HOME/.config/gtk-3.0"
mkdir -p "$config_dir"
cat > "$config_dir/gtk.css" <<EOF
/* AeroOS theme generated by AeroOS Appearance. */
@define-color aero_bg $bg;
@define-color aero_surface $surface;
@define-color aero_surface_hi $surface_hi;
@define-color aero_border $border;
@define-color aero_text $text;
@define-color aero_accent $accent;
@define-color aero_accent_hi $accent_hi;

window, .background { background-color: @aero_bg; color: @aero_text; }
headerbar, .titlebar {
  background-image: linear-gradient(to bottom, @aero_surface_hi, @aero_surface);
  color: @aero_text; border-color: @aero_border; box-shadow: none;
}
button {
  background-image: none; background-color: @aero_surface_hi;
  color: @aero_text; border: 1px solid @aero_border;
  border-radius: 9px; padding: 6px 11px; box-shadow: none;
}
button:hover { background-color: @aero_surface; border-color: @aero_accent; }
button:checked, button:active { background-color: @aero_surface_hi; border-color: @aero_accent; }
entry, spinbutton, combobox, textview, .view, treeview.view {
  background-color: @aero_surface; color: @aero_text;
  border-color: @aero_border; border-radius: 7px; caret-color: @aero_accent_hi;
}
*:selected, .view:selected, .view:selected:focus { background-color: @aero_accent; color: #ffffff; }
menubar, menu, .context-menu, popover { background-color: @aero_surface; color: @aero_text; }
menuitem:hover { background-color: @aero_surface_hi; color: @aero_text; }
tooltip {
  background-color: @aero_surface_hi; color: @aero_text;
  border: 1px solid @aero_border; border-radius: 7px;
}
#XfcePanelWindow {
  background-color: $panel; color: @aero_text;
  border-top: 1px solid $accent;
}
#whiskermenu-window {
  background-color: @aero_surface; color: @aero_text;
  border: 1px solid @aero_border; border-radius: 12px;
}
#docklike-plugin button {
  min-height: 42px; min-width: 42px; border-radius: 10px;
  background-image: none; background-color: transparent;
  border: 1px solid transparent; padding: 4px; box-shadow: none;
}
#docklike-plugin .open_group {
  background-color: @aero_surface_hi; border-bottom: 2px solid @aero_accent;
}
#docklike-plugin .active_group {
  background-color: @aero_surface_hi; border: 1px solid @aero_accent;
}
#docklike-plugin .hover_group {
  background-color: @aero_surface_hi; border: 1px solid @aero_accent_hi;
}
#docklike-plugin .window_count { color: @aero_text; }
EOF

xfconf-query -c xsettings -p /Net/ThemeName -s "$gtk_theme"
xfconf-query -c xsettings -p /Net/IconThemeName -s "$icon_theme"
xfconf-query -c xsettings -p /Gtk/CursorThemeName -s "Adwaita"
xfce4-panel --restart
xfdesktop --reload

zenity --info --title="$APP_TITLE" --width=460 --text="Applied: $choice

Your choice is saved in your AeroOS user profile. Already-open applications may need to be closed and reopened to pick up the new GTK style."
