#!/bin/sh
set -eu
MESSAGE="Welcome to AeroOS 0.1.0-alpha

AeroOS is a lightweight Debian-based desktop designed for older PCs.

Included applications:
• Firefox ESR — web browsing
• Thunar — files and folders
• Mousepad — text editing
• Parole — media playback
• Galculator — calculator
• Synaptic — package manager
• Xfce Settings — display, keyboard, power and desktop controls

Persistence:
Full persistence requires an ext4 USB volume labelled 'persistence' containing persistence.conf with this line:
/ union

Hardware:
This first version targets 64-bit PCs and traditional Legacy BIOS. Wi-Fi, graphics acceleration, suspend and special function keys must be checked on the actual laptop.

Safety:
This is an experimental Live USB. It does not install itself to your internal drive. Do not run an installer or partitioning tool unless you know exactly which disk is selected.

The temporary Live account is 'aero'. Change its password before using the system for sensitive work."

if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
  zenity --info --title="Welcome to AeroOS" --window-icon="aeroos" --width=560 --height=440 --text="$MESSAGE"
else
  printf '%s\n' "$MESSAGE"
fi
