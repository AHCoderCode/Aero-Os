#!/bin/sh
set -eu

if [ -z "${DISPLAY:-}" ] || ! command -v zenity >/dev/null 2>&1; then
  printf '%s\n' "Open Performance Profile from AeroOS Control Center."
  exit 1
fi

choice="$(zenity --list --radiolist --title="AeroOS Performance" --text="Choose the taskbar rendering mode for your laptop." --column="Use" --column="Profile" --print-column=2 --width=600 --height=320 TRUE "Transparent taskbar (recommended)" FALSE "Solid taskbar (maximum battery/compatibility)")" || exit 0

case "$choice" in
  "Transparent taskbar (recommended)")
    compositing=true
    animations=false
    ;;
  "Solid taskbar (maximum battery/compatibility)")
    compositing=false
    animations=false
    ;;
  *)
    exit 0
    ;;
esac

xfconf-query -c xfwm4 -p /general/use_compositing -s "$compositing"
xfconf-query -c xsettings -p /Gtk/EnableAnimations -s "$animations"

if [ "$compositing" = "true" ]; then
  result="The translucent taskbar is enabled. GTK animations remain disabled to keep the desktop light."
else
  result="The taskbar will use a solid background. Compositing is disabled to reduce graphics work and power use."
fi

zenity --info --title="AeroOS Performance" --width=500 --text="Applied: $choice

$result

This setting is saved in your user profile. You can return here at any time."
