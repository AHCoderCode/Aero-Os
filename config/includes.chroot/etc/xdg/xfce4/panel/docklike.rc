[user]
# Keep the centered dock lightweight on the HP's older Intel/Radeon graphics.
showPreviews=false
forceIconSize=true
iconSize=38
showWindowCount=false
disableLauncherCounts=true
indicatorColorFromTheme=true
# Expanding panel separators on each side keep this group centred.
pinned=aeroos-browser.desktop;aeroos-files.desktop;aeroos-terminal.desktop;aeroos-calculator.desktop;aeroos-editor.desktop;aeroos-media.desktop;aeroos-store.desktop;aeroos-settings.desktop;
