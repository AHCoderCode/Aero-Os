#!/bin/sh
set -eu

# Select LightDM as the graphical login manager for the live session.
mkdir -p /etc/systemd/system
ln -sf /lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service

# Keep Debian's /etc/os-release intact and expose AeroOS identity separately.
cat > /etc/aeroos-release <<'EOF'
NAME="AeroOS"
VERSION="0.1.0-alpha"
BASE="Debian GNU/Linux 13 (trixie)"
ARCHITECTURE="amd64"
TARGET="HP ProBook 4520s class hardware"
EOF

if [ -d /etc/skel/Desktop ]; then
  chmod 0755 /etc/skel/Desktop/*.desktop 2>/dev/null || true
fi
chmod 0755 /usr/local/bin/aeroos-welcome

# Trim package cache from the compressed read-only image.
rm -rf /var/lib/apt/lists/*
rm -f /var/cache/apt/archives/*.deb

# Do not remove the stock Debian kernel, drivers or firmware.
